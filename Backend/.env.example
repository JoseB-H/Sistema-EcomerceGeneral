# Opcional: npm run dev funciona sin archivo .env ni PostgreSQL.
# Solo desarrollo local; no copiar aquí el .env Docker de la raíz.
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
# Completar los tres valores solo después de instalar PostgreSQL localmente.
PGDATABASE=
PGUSER=
PGPASSWORD=

# Opcional: carpeta privada ABSOLUTA fuera de Git; no confundir con PostgreSQL.
# Windows: D:\YitVerse-Privado\lector (crear mediante reader:import / reader:demo).
YITVERSE_CONTENT_ROOT=
